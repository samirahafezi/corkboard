# Copy this file to .env. Do not commit .env.

# API server
PORT=8080

# Local Postgres (compose.yaml)
POSTGRES_DB=corkboard
POSTGRES_USER=corkboard
POSTGRES_PASSWORD=change-me-local-only

# How the API connects to Postgres. Keep the user and password in step with the values above.
DATABASE_URL=postgres://corkboard:change-me-local-only@127.0.0.1:5432/corkboard?sslmode=disable
